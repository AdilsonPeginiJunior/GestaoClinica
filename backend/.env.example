# Desenvolvimento/apresentação: copie para backend/.env
APP_ENV=demo
DEMO_SEED=true
# Somente no modo demo a chave e o banco padrão são permitidos.

# Produção: use APP_ENV=production, DEMO_SEED=false e uma base SEPARADA.
# SECRET_KEY deve ser gerada localmente: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Defina SECRET_KEY e DATABASE_URL no ambiente; não use exemplos como segredos.
# CORS_ORIGINS=["https://clinica.seu-dominio.com.br"]
# Os testes PostgreSQL/migrações/HTTPS continuam no plano OPS-01.
